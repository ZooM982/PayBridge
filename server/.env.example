# ── Serveur ──────────────────────────────────────────────
PORT=4000

# ── Bitnob (https://bitnob.dev) ───────────────────────────
# Créer un compte sandbox sur app.bitnob.com → Settings > API Keys.
# SANS ces deux variables, le serveur tourne en mode SIMULATION
# (même contrat d'API, statuts simulés) — pratique pour la démo/jury.
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_BASE_URL=https://api.bitnob.com

# Secret partagé pour vérifier la signature des webhooks entrants
BITNOB_WEBHOOK_SECRET=

# ── Intégration externe B2B ───────────────────────────────
# Clé Bearer pour protéger POST /api/payout (laissez vide = ouvert en dev).
# Exemple d'appel : Authorization: Bearer <API_KEY>
API_KEY=

# Origines CORS autorisées (CSV ou * pour tout autoriser).
# Exemple : https://monshop.com,https://app.monentreprise.com
ALLOWED_ORIGINS=*

# URL publique de ce serveur — utilisée pour les callbacks webhooks Bitnob.
# En prod : https://api.mondomaine.com — en dev local : laisser vide (localhost).
PUBLIC_BASE_URL=
